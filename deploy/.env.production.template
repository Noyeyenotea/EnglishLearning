# ============================================
# 生产环境 - 环境变量模板
# ============================================
# 复制此文件为 .env.production 并填写真实值
# 
# 重要安全提醒：
# 1. 部署前请务必修改以下密钥和密码
# 2. 不要将此文件提交到版本控制
# ============================================

# ---------- 数据库 ----------
# Docker Compose 环境：使用 Docker 服务名
DATABASE_URL="postgresql://postgres:ChangeMe123!@postgres:5432/english"
AI_DATABASE_URL="postgresql://postgres:ChangeMe123!@postgres:5432/langchain"

# PostgreSQL 密码 (Docker Compose 会使用此变量)
POSTGRES_PASSWORD="123456"

# ---------- 应用密钥 ----------
SECRET_KEY="请生成一个随机的32位以上密钥"

# ---------- Redis ----------
REDIS_HOST="redis"
REDIS_PORT=6379

# ---------- MinIO ----------
MINIO_ROOT_USER: ${MINIO_ROOT_USER:-minioadmin}
MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD:-ChangeMe123!}
MINIO_ENDPOINT: "minio"
MINIO_PORT: 9000
MINIO_USE_SSL: 0
MINIO_ACCESS_KEY: ${MINIO_ACCESS_KEY:-minioadmin}
MINIO_SECRET_KEY: ${MINIO_SECRET_KEY:-ChangeMe123!}
MINIO_BUCKET: "avatar"

# ---------- AI ----------
DEEPSEEK_API_KEY="你的DeepSeek API Key"
DEEPSEEK_API_MODEL="deepseek-chat"
DEEPSEEK_API_MODEL_REASONING="deepseek-reasoner"

# ---------- 博查搜索 ----------
BOCHA_API_KEY="你的Bocha API Key"
BOCHA_SEARCH_URL="https://api.bochaai.com/v1/web-search"

# ---------- 支付宝 ----------
ALIPAY_APP_ID="你的支付宝App ID"
ALIPAY_GATEWAY="https://openapi.alipay.com/gateway.do"
ALIPAY_PUBLIC_KEY="你的支付宝公钥"
ALIPAY_PRIVATE_KEY="你的支付宝私钥"
# 生产环境回调地址（需要公网可访问）
ALIPAY_NOTIFY_URL="https://你的域名/api/v1/pay/notify"

# ---------- 邮件 ----------
EMAIL_HOST="smtp.qq.com"
EMAIL_PORT=465
EMAIL_USER="你的邮箱"
EMAIL_PASSWORD="你的邮箱授权码"
EMAIL_FROM="你的邮箱"
EMAIL_USE_SSL=1

# ---------- 前端构建参数 ----------
# 前端环境变量通过 Docker build args 传递
VITE_MINIO_ENDPOINT: 'http://47.103.125.49:9000'
VITE_SOCKET_URL: 'http://47.103.125.49:3000'
