# ============================================
# NestJS 服务端 - 生产环境 Dockerfile
# ============================================
FROM node:22-alpine AS builder

WORKDIR /app

# 安装依赖（先复制 package 文件以利用 Docker 缓存）
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY server/package.json ./server/
COPY apps/server/package.json ./apps/server/
COPY apps/ai/package.json ./apps/ai/
COPY libs/shared/package.json ./libs/shared/
COPY packages/*/package.json ./packages/ 2>/dev/null || true

# 安装依赖
RUN npm install -g pnpm && pnpm install --frozen-lockfile

# 复制源代码
COPY . .

# 生成 Prisma Client
RUN cd server && pnpm prisma generate

# 构建服务端
RUN cd server && pnpm build

# ============================================
# 生产环境运行阶段
# ============================================
FROM node:22-alpine AS production

WORKDIR /app

# 安装依赖用于运行（生产模式不安装 devDependencies）
COPY server/package.json ./
RUN npm install -g pnpm && pnpm install --prod --frozen-lockfile

# 复制构建产物
COPY --from=builder /app/server/dist ./dist
COPY --from=builder /app/server/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/server/prisma ./prisma

# 创建非 root 用户
RUN addgroup -g 1001 -S nodejs && adduser -S nestjs -u 1001
USER nestjs

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/api/v1/course || exit 1

EXPOSE 3000

CMD ["node", "dist/apps/server/main.js"]
